{
  "name": "napoleonic-rts",
  "version": "1.4.6",
  "private": true,
  "description": "Browser Napoleonic RTS with Playwright Chromium regression, stress and soak tests",
  "scripts": {
    "audit": "node scripts/audit-codebase.js",
    "test:fast": "npm run audit && node --test tests/headless/*.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:ci": "npm run test:fast && npm run test:e2e",
    "art:list": "node scripts/generate-art.mjs --list",
    "art:dry": "node scripts/generate-art.mjs --dry-run",
    "art:generate": "node scripts/generate-art.mjs",
    "art:promote": "node scripts/promote-art.mjs",
    "art:atlas:pack": "python3 scripts/build-infantry-atlas.py",
    "art:atlas:validate": "python3 scripts/validate-infantry-atlas.py",
    "art:review": "python3 scripts/review-infantry-art.py",
    "start:server": "node server/index.js",
    "test:multiplayer": "playwright test tests/multiplayer-online-v146.spec.js --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "ws": "8.22.0"
  }
}
