{
  "name": "napoleonic-rts-desktop",
  "version": "1.4.7",
  "private": true,
  "description": "Napoleonic RTS as a Windows program",
  "author": "Napoleonic RTS",
  "main": "main.js",
  "scripts": {
    "site": "node prepare-site.js",
    "start": "node prepare-site.js && electron .",
    "dist": "node prepare-site.js && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "nl.napoleonic-rts.desktop",
    "productName": "Napoleonic RTS",
    "files": [
      "main.js",
      "site/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Napoleonic-RTS-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Napoleonic-RTS-${version}.exe"
    },
    "publish": null
  }
}
