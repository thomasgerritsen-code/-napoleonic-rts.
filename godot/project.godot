; Engine configuration file.
; Napoleonic RTS in Godot: the web game's battlefield, armies and look,
; rebuilt step by step as a native Godot project.

config_version=5

[application]

config/name="Napoleonic RTS"
config/description="Napoleonic battles: line infantry, volleys and morale."
config/version="0.1.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1400
window/size/viewport_height=860
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.105, 0.125, 0.086, 1)
